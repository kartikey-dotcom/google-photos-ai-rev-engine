# ==============================================================================
# Google Photos VoC Intelligence Engine - Environment Configuration Template
# LLM Provider: Google AI Studio (Gemini API)
# ==============================================================================

# 1. Google AI Studio API Key
# Obtain your free API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# 2. LLM Model Selection
# Recommended: gemini-1.5-flash (optimal speed/latency for analytical workflows)
# Alternative: gemini-1.5-pro (higher reasoning capacity)
GEMINI_MODEL=gemini-1.5-flash

# 3. LLM Provider Metadata
LLM_PROVIDER=Google AI Studio
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# 4. Clamped Analytical Inference Parameters
# Strictly enforced per architecture.md to guarantee deterministic, factual output
TEMPERATURE=0.2
TOP_P=0.8
TOP_K=40
MAX_OUTPUT_TOKENS=2048
